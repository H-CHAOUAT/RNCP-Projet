# Sur le serveur : cp .env.prod.example .env && chmod 600 .env

# Sous-domaine DuckDNS, sans https:// ni port
DOMAIN=mon-app.duckdns.org
DUCKDNS_TOKEN=

POSTGRES_USER=postgres
POSTGRES_DB=finfamdb
# openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -base64 48
JWT_SECRET=

# Mot de passe des 3 comptes de test, appliqué à leur création
SEED_PASSWORD=
